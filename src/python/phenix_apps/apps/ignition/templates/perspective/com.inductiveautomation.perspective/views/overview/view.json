        "meta": {
          "name": "Overview"
        },
        "propConfig": {
          "props.data": {
            "binding": {
              "config": {
                "expression": "now(2000)"
              },
              "transforms": [
                {
                  "code": "\trtus = system.tag.browse(\"[default]\").getResults()\n\trows = []\n\tfor r in rtus:\n\t\tif not r['hasChildren']:\n\t\t\tcontinue\n\t\tfolder = str(r['fullPath'])\n\t\tname = folder.split(\"]\")[-1]\n\t\tdiag = folder + \"/_Diagnostics_/\"\n\t\tqvals = system.tag.readBlocking([\n\t\t\tdiag + \"Connected\",\n\t\t\tdiag + \"Hostname\",\n\t\t\tdiag + \"Port\",\n\t\t\tdiag + \"Status\"\n\t\t])\n\t\tif qvals[0].quality.isGood():\n\t\t\trows.append({\n\t\t\t\t\"rtu\": name,\n\t\t\t\t\"connected\": bool(qvals[0].value),\n\t\t\t\t\"ip\": str(qvals[1].value),\n\t\t\t\t\"port\": str(qvals[2].value),\n\t\t\t\t\"status\": str(qvals[3].value)\n\t\t\t})\n\treturn rows",
                  "type": "script"
                }
              ],
              "type": "expr"
            }
          }
        },
