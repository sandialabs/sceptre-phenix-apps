        "events": {
          "component": {
            "onActionPerformed": {
              "config": {
                "script": "\tdev \u003d self.view.params.deviceName\n\tidx \u003d self.getSibling(\"IndexField\").props.value\n\top \u003d self.getSibling(\"OpTypeDropdown\").props.value\n\ttcc \u003d self.getSibling(\"TccDropdown\").props.value\n\tcnt \u003d self.getSibling(\"CountField\").props.value\n\tonT \u003d self.getSibling(\"OnTimeField\").props.value\n\toffT \u003d self.getSibling(\"OffTimeField\").props.value\n\tmode \u003d self.getSibling(\"ModeDropdown\").props.value\n\t\n\ttry:\n\t\tif mode \u003d\u003d \"select\":\n\t\t\tsystem.dnp.selectOperateBinary(dev, idx, tcc, op, cnt, onT, offT)\n\t\telse:\n\t\t\tsystem.dnp.directOperateBinary(dev, idx, tcc, op, cnt, onT, offT)\n\t\t\t\n\t\tself.getSibling(\"ResultLabel\").props.text \u003d \"Sent OK\"\n\texcept Exception as e:\n\t\tself.getSibling(\"ResultLabel\").props.text \u003d \"FAILED: \" + str(e)\n\t\t\n\t"
              },
              "scope": "G",
              "type": "script"
            }
          }
