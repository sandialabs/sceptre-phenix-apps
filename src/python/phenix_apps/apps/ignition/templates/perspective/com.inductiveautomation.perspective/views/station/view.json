        "events": {
          "component": {
            "onRowDoubleClick": {
              "config": {
                "script": "\timport re\n\tpoint \u003d event.value[\u0027point\u0027]\n\tm \u003d re.search(r\u0027BinaryOutput(\\d+)$\u0027, point)\n\tidx \u003d int(m.group(1)) if m else None\n\tcrob.openPopup(self.view.params.rtuName, idx)"
              },
              "scope": "G",
              "type": "script"
            }
          }
        },
        "meta": {
          "name": "pointsTable"
        },
        "position": {
          "grow": 1
        },
        "propConfig": {
          "props.data": {
            "binding": {
              "config": {
                "expression": "now(2000)"
              },
              "transforms": [
                {
                  "code": "\tfolder \u003d \"[default]\" + self.view.params.rtuName\n\tresults \u003d system.tag.browse(folder, {\"recursive\": True}).getResults()\n\tpaths \u003d [str(r[\u0027fullPath\u0027]) for r in results if not r[\u0027hasChildren\u0027]]\n\tif not paths:\n\t\treturn []\n\tqvals \u003d system.tag.readBlocking(paths)\n\trows \u003d []\n\tfor p, qv in zip(paths, qvals):\n\t\trows.append({\n\t\t\t\"point\": p.replace(folder + \"/\", \"\"),\n\t\t\t\"value\": str(qv.value),\n\t\t\t\"quality\": str(qv.quality),\n\t\t\t\"timestamp\": str(qv.timestamp)\n\t\t})\n\treturn rows",
                  "type": "script"
                }
              ],
              "type": "expr"
            }
          }
        },
