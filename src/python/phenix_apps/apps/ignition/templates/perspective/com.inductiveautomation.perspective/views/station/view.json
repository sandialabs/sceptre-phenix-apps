{
  "custom": {},
  "params": {
    "rtuName": ""
  },
  "propConfig": {
    "params.rtuName": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {},
  "root": {
    "children": [
      {
        "children": [
          {
            "meta": {
              "name": "Hint"
            },
            "props": {
              "text": "Double-click a point, or select one and press"
            },
            "type": "ia.display.label"
          },
          {
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\t# the selected row's OPC address picks the output kind and index, if any\n\trows = self.parent.getSibling(\"pointsTable\").props.selection.data\n\ttry:\n\t\taddress = rows[0]['address']\n\texcept (IndexError, KeyError, TypeError):\n\t\taddress = None\n\tcommands.openPopup(self.view.params.rtuName, address)\n"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "name": "CommandButton"
            },
            "position": {
              "basis": "160px",
              "shrink": 0
            },
            "props": {
              "text": "DNP3 Command"
            },
            "type": "ia.input.button"
          }
        ],
        "meta": {
          "name": "toolbar"
        },
        "position": {
          "basis": "44px",
          "shrink": 0
        },
        "props": {
          "alignItems": "center",
          "direction": "row",
          "justify": "flex-end",
          "style": {
            "gap": "8px",
            "padding": "4px"
          }
        },
        "type": "ia.container.flex"
      },
      {
        "custom": {
          "rtuName": "ST0-rtu"
        },
        "events": {
          "component": {
            "onRowDoubleClick": {
              "config": {
                "script": "\t# the OPC address says whether the row is an output point and which index\n\tcommands.openPopup(self.view.params.rtuName, event.value['address'])"
              },
              "scope": "G",
              "type": "script"
            }
          }
        },
        "meta": {
          "name": "pointsTable"
        },
        "position": {
          "grow": 1
        },
        "propConfig": {
          "props.data": {
            "binding": {
              "config": {
                "expression": "now(2000)"
              },
              "transforms": [
                {
                  "code": "\tfolder = \"[default]\" + self.view.params.rtuName\n\tresults = system.tag.browse(folder, {\"recursive\": True}).getResults()\n\tpaths = [str(r['fullPath']) for r in results if not r['hasChildren']]\n\tif not paths:\n\t\treturn []\n\t# one read for values, documentation and OPC addresses together\n\tqvals = system.tag.readBlocking(paths + [p + \".Documentation\" for p in paths] + [p + \".OpcItemPath\" for p in paths])\n\tn = len(paths)\n\trows = []\n\tfor i, p in enumerate(paths):\n\t\tqv = qvals[i]\n\t\trows.append({\n\t\t\t\"point\": p.replace(folder + \"/\", \"\"),\n\t\t\t\"description\": str(qvals[n + i].value or \"\"),\n\t\t\t\"value\": str(qv.value),\n\t\t\t\"quality\": str(qv.quality),\n\t\t\t\"timestamp\": str(qv.timestamp),\n\t\t\t\"address\": str(qvals[2 * n + i].value or \"\")\n\t\t})\n\treturn rows",
                  "type": "script"
                }
              ],
              "type": "expr"
            }
          }
        },
