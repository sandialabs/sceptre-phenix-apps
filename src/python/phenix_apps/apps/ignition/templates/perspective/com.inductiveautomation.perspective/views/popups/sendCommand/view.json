      {
        "events": {
          "component": {
            "onActionPerformed": {
              "config": {
                "script": "\tdev = self.view.params.deviceName\n\tcmd = self.getSibling(\"CommandDropdown\").props.value\n\t\n\ttry:\n\t\tif cmd == \"poll\":\n\t\t\tpoll = self.getSibling(\"pollParams\")\n\t\t\tclasses = [c for c in (1, 2, 3, 0) if poll.getChild(\"Class%d\" % c).props.selected]\n\t\t\tsystem.dnp.demandPoll(dev, classes)\n\t\telif cmd == \"analog\":\n\t\t\tanalog = self.getSibling(\"analogParams\")\n\t\t\tidx = analog.getChild(\"IndexField\").props.value\n\t\t\tmode = analog.getChild(\"ModeDropdown\").props.value\n\t\t\tvariation = analog.getChild(\"VariationDropdown\").props.value\n\t\t\tvalue = commands.analogValue(analog.getChild(\"ValueField\").props.value, variation)\n\t\t\tif mode == \"Select\":\n\t\t\t\tsystem.dnp.selectOperateAnalog(dev, variation, idx, value)\n\t\t\telse:\n\t\t\t\tsystem.dnp.directOperateAnalog(dev, variation, idx, value)\n\t\telse:\n\t\t\tcrob = self.getSibling(\"crobParams\")\n\t\t\tidx = crob.getChild(\"IndexField\").props.value\n\t\t\tmode = crob.getChild(\"ModeDropdown\").props.value\n\t\t\top = crob.getChild(\"OpTypeDropdown\").props.value\n\t\t\ttcc = crob.getChild(\"TccDropdown\").props.value\n\t\t\tcnt = crob.getChild(\"CountField\").props.value\n\t\t\tonT = crob.getChild(\"OnTimeField\").props.value\n\t\t\toffT = crob.getChild(\"OffTimeField\").props.value\n\t\t\tif mode == \"Select\":\n\t\t\t\tsystem.dnp.selectOperateBinary(dev, idx, tcc, op, cnt, onT, offT)\n\t\t\telse:\n\t\t\t\tsystem.dnp.directOperateBinary(dev, idx, tcc, op, cnt, onT, offT)\n\t\t\n\t\tself.getSibling(\"ResultLabel\").props.text = \"Sent OK\"\n\texcept Exception as e:\n\t\tself.getSibling(\"ResultLabel\").props.text = \"FAILED: \" + str(e)\n\t"
              },
              "scope": "G",
              "type": "script"
            }
          }
